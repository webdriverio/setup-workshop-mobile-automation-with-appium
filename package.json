{
  "name": "workshop-setup-check",
  "version": "1.0.0",
  "description": "Environment health check for the Appium + WebdriverIO workshop",
  "type": "module",
  "scripts": {
    "check": "node scripts/check-setup.mjs",
    "start:devices": "node scripts/start-devices.mjs",
    "start:android": "node scripts/start-devices.mjs android",
    "start:ios": "node scripts/start-devices.mjs ios",
    "setup": "node scripts/setup.mjs",
    "test": "node --experimental-test-module-mocks --test \"test/**/*.test.mjs\"",
    "test:watch": "node --experimental-test-module-mocks --test --watch \"test/**/*.test.mjs\"",
    "coverage": "node test/run-coverage.mjs",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.7.5",
    "@wdio/appium-service": "10.2.0-alpha.100.sha-b38abd894",
    "@wdio/cli": "^10.1.0",
    "@wdio/globals": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "appium": "^3.9.0",
    "appium-uiautomator2-driver": "^8.7.3",
    "appium-xcuitest-driver": "^12.22.8",
    "start-android-emulator": "^4.1.3",
    "start-ios-simulator": "^2.0.0",
    "webdriverio": "^10.1.0"
  },
  "dependencies": {
    "extract-zip": "^2.0.1"
  }
}
